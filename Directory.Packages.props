<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <!-- Test -->
        <PackageVersion Include="Alba" Version="8.5.3" />
        <!-- Aspire -->
        <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
        <!-- Aspire (preview — Keycloak hosting has no stable 13.4.x; see ADR 0010) -->
        <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.4.6-preview.1.26319.6" />
        <!-- Aspire-->
        <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
        <!-- Aspire-->
        <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.4" />
        <!-- Aspire (13.7) -->
        <PackageVersion Include="Aspire.Hosting.Seq" Version="13.6.4" />
        <!-- Test -->
        <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
        <!-- Infrastructure (14.44) — Entra tokens for the Postgres and Redis
             data planes. ADR 0017. -->
        <PackageVersion Include="Azure.Identity" Version="1.21.0" />
        <!-- Test -->
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
        <!-- Infrastructure -->
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <!-- Test -->
        <PackageVersion Include="FluentAssertions" Version="8.11.0" />
        <!-- Application -->
        <PackageVersion Include="FluentValidation" Version="12.2.0" />
        <!-- Api -->
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <!-- Test -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <!-- Api -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <!-- Infrastructure (14.45) — Entra token auth + proactive re-auth for
             Azure Managed Redis. Brings StackExchange.Redis transitively;
             deliberately the only pin for it. ADR 0017. -->
        <PackageVersion Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
        <!-- Infrastructure -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <!-- Infrastructure, Api -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
        <!-- Test -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
        <!-- transitive of Design + Npgsql; pinned to keep the EF family uniform -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
        <!-- Infrastructure -->
        <PackageVersion
            Include="Microsoft.Extensions.Caching.StackExchangeRedis"
            Version="10.0.12"
        />
        <!-- Worker -->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <!-- Security pin: forces transitive Microsoft.OpenApi off vulnerable 2.0.0
       (GHSA-v5pm-xwqc-g5wc). Stay on 2.x — 3.x breaks .NET 10 built-in OpenAPI. -->
        <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
        <!-- MessagePack for serialization - AppHost -->
        <PackageVersion Include="MessagePack" Version="3.1.8" />
        <!-- Aspire -->
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <!-- Aspire -->
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
        <!-- Test -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <!-- Test -->
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <!-- Infrastructure -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <!-- Test -->
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <!-- Aspire -->
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <!-- Aspire -->
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <!-- Aspire -->
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
        <!-- Aspire -->
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
        <!-- Aspire -->
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
        <!-- Worker -->
        <PackageVersion Include="Quartz" Version="3.22.9" />
        <!-- Worker -->
        <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.22.9" />
        <!-- ServiceDefaults (13.1) — bundles Serilog core, Console sink,
             Settings.Configuration, Formatting.Compact, Extensions.Hosting -->
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
        <!-- ServiceDefaults (13.2) — MachineName/EnvironmentName enrichers; ADR 0013 -->
        <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
        <!-- ServiceDefaults (13.1) — OTLP logs; reads OTEL_EXPORTER_OTLP_* env vars -->
        <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
        <!-- ServiceDefaults (13.1) -->
        <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
        <!-- Api -->
        <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
        <!-- Test -->
        <PackageVersion Include="Scriban.Signed" Version="7.2.5" />
        <!-- Security pin: forces transitive SSH.NET (via Testcontainers) off
             vulnerable 2025.1.0 (GHSA-q939-rpr3-3284 / CVE-2026-48798, path
             traversal in ScpClient.Download). Drop once Testcontainers ships a
             release that depends on 2026.0.0 or later itself. -->
        <PackageVersion Include="SSH.NET" Version="2026.0.0" />
        <!-- Test -->
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <!-- Test -->
        <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
        <!-- Test -->
        <PackageVersion Include="WireMock.Net" Version="2.13.0" />
        <!-- Application, Api, Worker -->
        <PackageVersion Include="WolverineFx" Version="6.63.0" />
        <!-- Worker -->
        <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.63.0" />
        <!-- Api, Worker -->
        <PackageVersion Include="WolverineFx.FluentValidation" Version="6.63.0" />
        <!-- added in 5.7 -->
        <PackageVersion Include="WolverineFx.Http" Version="6.63.0" />
        <!-- Worker -->
        <PackageVersion Include="WolverineFx.Postgresql" Version="6.63.0" />
        <!-- Api, Worker -->
        <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.63.0" />
        <!-- Test -->
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <!-- Test -->
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>
</Project>
